/* chat 页面样式 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 聊天容器 */
.chat-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 时间戳样式（仿微信居中样式） */
.message-time-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 30rpx 0 10rpx 0;
}

.message-time {
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  opacity: 0.8;
}

/* 消息项 */
.message-item {
  margin-bottom: 30rpx;
}

.message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

/* 用户消息 */
.user-message {
  justify-content: flex-end;
}

.user-message .message-content {
  background: #007AFF;
  color: white;
  border-radius: 20rpx 20rpx 8rpx 20rpx;
  max-width: 70%;
  margin-right: 20rpx;
}

.user-avatar {
  background: #007AFF;
  color: white;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

/* AI消息 */
.ai-message {
  justify-content: flex-start;
}

.ai-message .message-content {
  background: white;
  color: #333;
  border-radius: 20rpx 20rpx 20rpx 8rpx;
  max-width: 70%;
  margin-left: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.ai-avatar {
  background: #34C759;
  color: white;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

/* 消息内容 */
.message-content {
  padding: 20rpx 24rpx;
  position: relative;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.4;
  word-wrap: break-word;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  background: #999;
  border-radius: 50%;
  margin-right: 8rpx;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {

  0%,
  60%,
  100% {
    transform: translateY(0);
    opacity: 0.4;
  }

  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: white;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  opacity: 0.8;
  display: block;
}

/* 输入容器 */
.input-container {
  background: white;
  padding: 20rpx;
  border-top: 1rpx solid #eee;
}

.input-wrapper {
  display: flex;
  align-items: flex-end;
  /* 修改为底部对齐，适合多行文本 */
  background: #f5f5f5;
  border-radius: 30rpx;
  /* 稍微减小圆角以适应多行 */
  padding: 16rpx 20rpx;
}

.message-input {
  flex: 1;
  min-height: 40rpx;
  max-height: 200rpx;
  /* 限制最高高度 */
  font-size: 28rpx;
  line-height: 40rpx;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
}

.send-btn {
  background: #007AFF;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  min-width: 120rpx;
}

.send-btn:disabled {
  background: #ccc;
  color: #999;
}

.send-btn.loading {
  background: #007AFF;
  opacity: 0.7;
}



/* 顶部标题栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.settings-btn {
  font-size: 36rpx;
  padding: 10rpx;
  cursor: pointer;
}

/* 设置弹窗 */
.settings-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: none;
  justify-content: center;
  align-items: center;
}

.settings-modal.show {
  display: flex;
  animation: fadeIn 0.3s ease;
}

.settings-content {
  width: 90%;
  max-height: 80vh;
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #eee;
}

.settings-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-icon {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
  cursor: pointer;
}

/* 预设角色部分 */
.presets-section {
  margin-bottom: 20rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.presets-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.preset-card {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s ease;
  border: 3rpx solid transparent;
}

.preset-card.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: #667eea;
}

.preset-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 10rpx;
}

.preset-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.preset-card.active .preset-name,
.preset-card.active .preset-desc {
  color: white;
}

.preset-desc {
  display: block;
  font-size: 22rpx;
  color: #666;
}

.custom-btn {
  width: 100%;
  background: white;
  border: 2rpx solid #667eea;
  color: #667eea;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 自定义设置部分 */
.custom-section {
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  background: #f5f7fa;
  border: 2rpx solid #e9ecef;
  border-radius: 15rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 64rpx; /* 确保单行输入不会被裁剪 */
  line-height: 36rpx; /* 使文字垂直居中 */
  box-sizing: border-box;
  overflow: visible; /* 避免在部分设备上裁剪文字 */
  white-space: pre-wrap; /* 支持换行显示 */
  word-break: break-word;
}

.form-textarea {
  min-height: 120rpx; /* 提高初始高度，避免首行被遮挡 */
  max-height: 320rpx; /* 允许展开更多内容 */
  line-height: 1.6;
  width: 100%;
  box-sizing: border-box;
  overflow: auto; /* 超出后可以滚动，避免自动剪裁 */
  white-space: pre-wrap;
  word-break: break-word;
  resize: none; /* 小程序中避免用户手动拖拽样式 */
}

.custom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.cancel-btn,
.save-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  border: none;
}

.save-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(50rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}