.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 输入区域 */
.input-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  animation: fadeIn 0.5s ease;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.work-input {
  width: 100%;
  height: 300rpx;
  background: #f5f7fa;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.generate-btn {
  background: #007AFF;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.generate-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.generate-btn.loading {
  opacity: 0.7;
  background: #5ac8fa;
}

.generate-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}

/* 战报展示区域 */
.report-container {
  flex: 1;
  padding-bottom: 40rpx;
}

.report-header {
  text-align: center;
  margin-bottom: 30rpx;
  color: white;
}

.report-date {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  animation: slideUp 0.5s ease;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #007AFF;
  padding-left: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

/* 属性卡片 */
.attr-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.attr-item {
  background: #e3f2fd;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
}

.attr-name {
  font-size: 24rpx;
  color: #1565c0;
  margin-right: 10rpx;
}

.attr-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #0d47a1;
}

/* 列表内容 */
.list-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: #555;
}

.dot {
  color: #007AFF;
  margin-right: 16rpx;
  font-weight: bold;
}

/* 成就卡片特别样式 */
.achievements-card .card-title {
  border-left-color: #ff9800;
}

.achievements-card .dot {
  color: #ff9800;
}

/* 返回按钮 */
.back-btn {
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: white;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 历史记录开关 */
.history-toggle {
  text-align: center;
  padding: 20rpx;
  margin-top: auto;
}

.history-toggle text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  text-decoration: underline;
}

/* 历史记录弹窗 */
.history-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: none;
  justify-content: center;
  align-items: flex-end;
}

.history-modal.show {
  display: flex;
  animation: fadeIn 0.3s ease;
}

.history-content {
  width: 100%;
  height: 70vh;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  animation: slideUpModal 0.3s ease;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.history-header text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-icon {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.history-list {
  flex: 1;
  overflow-y: auto;
}

.history-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-date {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.history-summary {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-history {
  text-align: center;
  color: #999;
  padding-top: 100rpx;
  font-size: 28rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes slideUpModal {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

