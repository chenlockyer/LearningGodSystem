<view class="container">
  <view class="card">
    <view class="card-title">发布任务</view>
    <form bindsubmit="onAddTask">
      <view class="form-item">
        <view class="input-wrapper">
          <input name="title" maxlength="16" bindinput="onInputSanitize" placeholder="任务名称（最多15字）" class="form-input" value="{{title}}" />
          <text class="count-hint {{titleCount >= 15 ? 'count-limit' : ''}}">
            {{titleCount}}/15
          </text>
        </view>
      </view>
      <view class="form-item">
        <textarea name="description" placeholder="任务描述（可选）" class="form-input form-textarea" maxlength="200" value="{{description}}" auto-height />
      </view>
      <view class="form-row">
        <view class="form-item-half">
          <picker bindchange="onAttrChange" value="{{attrIndex}}" range="{{attrOptions}}">
            <view class="input-wrapper">
              <view class="form-input picker-view">
                <text class="value-text">{{rewardAttr}}</text>
              </view>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <input name="rewardAttr" value="{{rewardAttr}}" style="display:none" />
        </view>
        <view class="form-item-half">
          <picker bindchange="onExpChange" value="{{expIndex}}" range="{{expOptions}}">
            <view class="input-wrapper">
              <view class="form-input picker-view">
                <text class="value-text">{{rewardExp}}</text>
              </view>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <input name="rewardExp" value="{{rewardExp}}" style="display:none" />
        </view>
      </view>
      <button formType="submit" class="btn-primary">新增任务</button>
    </form>
  </view>
  <view class="card">
    <view class="card-title">任务列表 ({{tasks.length}})</view>
    <view wx:if="{{tasks.length === 0}}" class="empty-state">
      <text class="empty-text">暂无任务</text>
      <text class="empty-hint">创建新任务或从聊天记录导入</text>
    </view>
    <view wx:for="{{tasks}}" wx:key="id" class="task-item">
      <view class="task-header">
        <view class="task-title-row">
          <text class="task-title">{{item.title}}</text>
          <view wx:if="{{item.source === 'ai_import'}}" class="task-badge ai-badge">AI导入</view>
        </view>
        <view wx:if="{{item.description}}" class="task-description">{{item.description}}</view>
      </view>
      <view wx:if="{{!item.done}}" class="progress-section">
        <view class="progress-info">
          <text class="progress-text">完成进度</text>
          <text class="progress-percent">{{item.progress || 0}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.progress || 0}}%; background-color: {{item.progressColor}};"></view>
        </view>
      </view>
      <view class="task-info">
        <view class="task-reward">
          <text class="reward-label">奖励：</text>
          <text class="reward-value">{{item.rewardAttr}} +{{item.rewardExp}}</text>
        </view>
        <view wx:if="{{item.done && item.rating}}" class="task-rating">
          <text class="rating-label">评级：</text>
          <text class="rating-value" style="color: {{item.rating === 'excellent' ? '#34C759' : item.rating === 'good' ? '#007AFF' : item.rating === 'normal' ? '#FF9500' : '#FF3B30'}}">
            {{item.rating === 'excellent' ? '优秀' : item.rating === 'good' ? '良好' : item.rating === 'normal' ? '普通' : '较差'}}
          </text>
        </view>
      </view>
      <view class="task-actions">
        <button wx:if="{{!item.done}}" class="btn-complete" bindtap="onComplete" data-id="{{item.id}}">
          完成任务
        </button>
        <view wx:else class="task-status">
          <text class="status-text">✓ 已完成</text>
          <text wx:if="{{item.rating}}" class="status-rating">
            ({{item.rating === 'excellent' ? '优秀' : item.rating === 'good' ? '良好' : item.rating === 'normal' ? '普通' : '较差'}})
          </text>
        </view>
      </view>
    </view>
  </view>
</view>