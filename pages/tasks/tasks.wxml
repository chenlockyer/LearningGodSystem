<view class="container">
  <view class="card">
    <view class="card-title">发布任务</view>
    <form bindsubmit="onAddTask">
      <view class="form-item">
        <view class="input-wrapper">
          <input name="title" maxlength="16" bindinput="onInputSanitize" placeholder="任务名称（最多15字）" class="form-input" value="{{title}}" />
          <text class="count-hint {{titleCount >= 15 ? 'count-limit' : ''}}">
            {{titleCount}}/15
          </text>
        </view>
      </view>
      <view class="form-item">
        <textarea name="description" placeholder="任务描述（可选）" class="form-input form-textarea" maxlength="1000" value="{{description}}" auto-height />
      </view>
      <!-- 多重奖励行 -->
      <view class="rewards-section">
        <view class="reward-row" wx:for="{{rewards}}" wx:key="index">
          <view class="form-item-half">
            <picker bindchange="onRewardAttrChange" data-index="{{index}}" value="{{item.attrIndex}}" range="{{attrOptions}}">
              <view class="input-wrapper">
                <view class="form-input picker-view">
                  <text class="value-text">{{attrOptions[item.attrIndex]}}</text>
                </view>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <view class="form-item-half">
            <picker bindchange="onRewardExpChange" data-index="{{index}}" value="{{item.expIndex}}" range="{{expOptions}}">
              <view class="input-wrapper">
                <view class="form-input picker-view">
                  <text class="value-text">{{expOptions[item.expIndex]}} exp</text>
                </view>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <!-- 删除按钮（仅当多于一行时显示） -->
          <view class="delete-btn" wx:if="{{rewards.length > 1}}" bindtap="onRemoveRewardRow" data-index="{{index}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
        <view class="add-reward-btn" bindtap="onAddRewardRow">
          <text>+ 添加更多奖励</text>
        </view>
      </view>
      <button formType="submit" class="btn-primary">新增任务</button>
    </form>
  </view>
  <view class="card">
    <view class="card-title">任务列表 ({{tasks.length}})</view>
    <view wx:if="{{tasks.length === 0}}" class="empty-state">
      <text class="empty-text">暂无任务</text>
    </view>
    <view wx:for="{{tasks}}" wx:key="id" class="task-item">
      <view class="task-header">
        <view class="task-title-row">
          <text class="task-title">{{item.title}}</text>

        </view>
        <view wx:if="{{item.description}}" class="task-description {{item.expanded ? 'expanded' : ''}}" bindtap="onToggleDescription" data-id="{{item.id}}">
          {{item.description}}
        </view>
      </view>
      <view wx:if="{{!item.done}}" class="progress-section">
        <view class="progress-info">
          <text class="progress-text">完成进度</text>
          <text class="progress-percent">{{item.progress || 0}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.progress || 0}}%; background-color: {{item.progressColor}};"></view>
        </view>
      </view>
      <view class="task-info">
        <view class="task-reward">
          <text class="reward-label">奖励：</text>
          <view class="reward-tags">
            <block wx:if="{{item.rewards}}">
              <text class="reward-tag" wx:for="{{item.rewards}}" wx:for-item="reward" wx:key="unique">
                {{reward.attr}} +{{reward.exp}}
              </text>
            </block>
            <!-- 兼容旧数据 -->
            <block wx:else>
              <text class="reward-tag">{{item.rewardAttr}} +{{item.rewardExp}}</text>
            </block>
          </view>
        </view>
        <view wx:if="{{item.done && item.rating}}" class="task-rating">
          <text class="rating-label">评级：</text>
          <text class="rating-value" style="color: {{item.rating === 'excellent' ? '#34C759' : item.rating === 'good' ? '#007AFF' : item.rating === 'normal' ? '#FF9500' : '#FF3B30'}}">
            {{item.rating === 'excellent' ? '优秀' : item.rating === 'good' ? '良好' : item.rating === 'normal' ? '普通' : '较差'}}
          </text>
        </view>
      </view>
      <view class="task-actions">
        <button wx:if="{{!item.done}}" class="btn-complete" bindtap="onComplete" data-id="{{item.id}}">
          完成任务
        </button>
        <view wx:else class="task-status">
          <text class="status-text">✓ 已完成</text>
          <text wx:if="{{item.rating}}" class="status-rating">
            ({{item.rating === 'excellent' ? '优秀' : item.rating === 'good' ? '良好' : item.rating === 'normal' ? '普通' : '较差'}})
          </text>
        </view>
      </view>
    </view>
  </view>
</view>