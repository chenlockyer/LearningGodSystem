/* tasks 页面基础容器 */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 卡片通用样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 表单通用项 */
.form-item {
  margin-bottom: 20rpx;
}

/* 输入框包装容器，用于定位计数提示和选择器箭头 */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

/* 任务名计数字数提示 */
.count-hint {
  position: absolute;
  right: 20rpx;
  font-size: 22rpx;
  color: #bbb;
  pointer-events: none;
}

.count-limit {
  color: #FF3B30;
  font-weight: bold;
}

/* 半宽对齐容器 */
.form-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.form-item-half {
  flex: 1;
  position: relative;
}

/* 统一输入框与选择器外观基础样式 */
.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  /* 默认左右间距 */
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.form-textarea {
  height: auto;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  align-items: flex-start;
}

.form-input:focus {
  border-color: #007AFF;
  background: white;
}

/* 核心：选择器容器居中处理 */
.picker-view {
  justify-content: center;
  /* 水平居中 */
  padding: 0 !important;
  /* 清除 padding 以防干扰居中 */
  background: white !important;
}

/* 选择器内的文字样式 */
.value-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}

/* 选择器箭头：绝对定位在右侧，不参与 flex 居中计算 */
.picker-arrow {
  position: absolute;
  right: 15rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: #999;
  pointer-events: none;
  /* 点击穿透，确保能触发底层的 picker */
}

/* 按钮样式 */
.btn-primary {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
}





/* 任务列表项样式 */
.task-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 任务信息卡片（灰色区域） */
.task-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 20rpx 0;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.reward-value {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 500;
}

/* 完成任务按钮及状态 */
.btn-complete {
  width: 100%;
  height: 72rpx;
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.task-status {
  text-align: center;
  padding: 20rpx;
  color: #34C759;
  font-weight: 500;
}